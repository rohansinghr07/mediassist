+    async def run_call_reminders(self):
+        """Phone-call reminder (Exotel) about 2 hours before the visit - reaches every patient with a mobile
+        number, including walk-ins without Telegram. One attempt per booking (a reschedule allows a new one)."""
+        if not settings.exotel_ready:
+            return 0
+        now = db.utcnow()
+        local_now = now.astimezone(TZ)
+        if not (settings.CALL_EARLIEST_HOUR <= local_now.hour < settings.CALL_LATEST_HOUR):
+            return 0  # no calls at night; early-morning visits get their call at 8 am instead
+        day_start = local_now.replace(hour=0, minute=0, second=0, microsecond=0)
+        made_today = await db.appointments.count_documents({"call_reminder.at": {"$gte": day_start}})
+        due = await db.appointments.find({
+            "status": "booked", "phone": {"$nin": [None, ""]}, "reminders_sent": {"$ne": "call"},
+            "start": {"$gt": now + timedelta(minutes=15), "$lte": now + timedelta(hours=2)},
+        }).sort("start", 1).to_list(None)
+        placed = 0
+        for appt in due:
+            if made_today >= settings.CALL_DAILY_LIMIT:
+                log.warning("Call reminders: daily limit of %s reached", settings.CALL_DAILY_LIMIT)
+                break
+            record = {"at": db.utcnow()}
+            try:
+                result = await exotel.call_reminder(appt["phone"], appt["_id"])
+                record.update({"status": "placed", "sid": result.get("sid")})
+                placed += 1
+            except exotel.ExotelError as exc:
+                log.warning("Call reminder failed for %s: %s", appt["_id"], exc)
+                record.update({"status": "failed", "error": str(exc)[:200]})
+            made_today += 1
+            await db.appointments.update_one({"_id": appt["_id"]},
+                                             {"$set": {"call_reminder": record}, "$push": {"reminders_sent": "call"}})
+        return placed
+
+    def call_greeting(self, appt):
+        """What the reminder call says (Exotel reads it aloud). Used only when the flow fetches text from our URL."""
+        if not appt or appt.get("status") != "booked":
+            return (f"Namaste. This is {settings.CLINIC_NAME}. This is a reminder about your appointment today. "
+                    "For details, please check Telegram or call the clinic. Thank you.")
+        local = db.aware(appt["start"]).astimezone(TZ)
+        first = (appt.get("patient_name") or "").split(" ")[0]
+        return (f"Namaste {first}. This is {settings.CLINIC_NAME}. Your appointment with {appt['doctor_name']} "
+                f"is today at {local.strftime('%I:%M %p').lstrip('0')}. Your booking I D is "
+                f"{' '.join(appt['_id'].replace('-', ' '))}. Please arrive 10 minutes early. "
+                "To cancel or change the time, use Telegram or call the clinic. Thank you.")
+
     async def run_reminders(self):
+        try:
+            await self.run_call_reminders()
+        except Exception:
+            log.exception("call reminders failed")
         now = db.utcnow()
         due = await db.appointments.find(
             {"status": "booked", "start": {"$gt": now, "$lte": now + timedelta(hours=24)}}
