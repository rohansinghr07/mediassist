+@router.api_route("/exotel/greeting", methods=["GET", "HEAD"])
+async def exotel_greeting(request: Request, CustomField: str = "", CallSid: str = ""):
+    """Text the Exotel reminder call reads aloud ("Greeting -> dynamic text from URL").
+    Exotel calls this with CallSid + CustomField (= the booking ID). Needs a public URL, i.e. after deployment."""
+    _limit(request)
+    from engine import Engine
+    appt = None
+    if CallSid and re.fullmatch(r"APT-\d{4,6}", CustomField or ""):
+        appt = await db.appointments.find_one({"_id": CustomField})
+    text = Engine.call_greeting(None, appt)
+    # same headers for HEAD and GET (the server leaves out the body for HEAD); exactly "text/plain" as Exotel asks
+    response = Response(content=text.encode("utf-8"))
+    response.headers["Content-Type"] = "text/plain"
+    return response
