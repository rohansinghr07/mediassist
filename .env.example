# Copy this file to ".env" (same folder) and fill in your values.
# Never share the .env file - it holds your secret keys.

# ---------- Clinic ----------
CLINIC_NAME=City Clinic, Kota
CLINIC_PHONE=+91-9XXXXXXXXX
CLINIC_TZ=Asia/Kolkata

# ---------- Telegram (from @BotFather) ----------
TELEGRAM_BOT_TOKEN=
# Optional: chat ID of a staff Telegram group that should get emergency alerts
STAFF_CHAT_ID=

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=mediassist

# ---------- Cal.com (Settings -> Developer -> API Keys) ----------
CAL_API_KEY=cal_live_xxxxxxxxxxxxxxxx
# Optional: set the same secret in the Cal.com webhook settings
CAL_WEBHOOK_SECRET=
# REQUIRED: real email used when a patient skips email (becomes yourname+tg123@gmail.com)
FALLBACK_EMAIL=yourclinic@gmail.com

# ---------- AI (pick ONE) ----------
# OpenAI:
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Groq (free tier) - use these instead:
# LLM_API_KEY=gsk_xxxxxxxx
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b

# Voice messages (speech-to-text). Groq: whisper-large-v3 | OpenAI: whisper-1
STT_MODEL=whisper-large-v3

# ---------- Booking rules ----------
BOOKING_DAYS_AHEAD=7
MIN_LEAD_MINUTES=30
SESSION_TIMEOUT_MINUTES=30

# ---------- Dashboard login ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=put-any-long-random-text-here
